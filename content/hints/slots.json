        {
          "key": "benefit",
          "intent": "benefit",
          "enabled": true,
          "fields": {
            "title": "Start with **a blank canvas**",
            "body": "Put your first thought on the board. A template or an agent can help you organise it later."
          }
        },
        {
          "key": "together",
          "intent": "together",
          "enabled": true,
          "fields": {
            "title": "Make room **for your team**",
            "body": "Invite a teammate and they’ll see your cursor right away. While you wait, double-click to add your first sticker."
