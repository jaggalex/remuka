#!/usr/bin/env bash
# Server entry point. Install as <root>/remo; the instance is the directory the controller
# lives in (REMO_ROOT overrides it for an unusual layout). The compose project and edge
# alias come from <root>/shared/instance.env written by the first deploy (ADR-261). Never
# source the environment as shell.
set -Eeuo pipefail
umask 077
# The controller is installed as <root>/remo, so its own directory is the instance. Deriving
# the root is what keeps /srv/stage-ru/remo from reading /srv/remo/current and opening the
# production database by accident. REMO_ROOT stays as an explicit override for a controller
# installed elsewhere.
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=${REMO_ROOT:-$script_dir}
export REMO_PRODUCTION_ENV="$ROOT/shared/production.env"
mkdir -p "$ROOT/backups"
exec 9>"$ROOT/.operation.lock"
flock -n 9 || { echo 'Another remo operation is running.' >&2; exit 1; }

# The instance's identity: which compose project owns its containers and which alias in
# the shared `edge` network is its web container. It is written on the first deploy and
# read afterwards, so a hand-run `/srv/stage-ru/remo status` cannot open the project that
# belongs to another instance. The file is written here, yet it is still parsed as data:
# a manual edit must not become shell code.
instance_value() {
  local key=$1 line file="$ROOT/shared/instance.env"
  [[ -f $file ]] || return 0
  while IFS= read -r line; do
    case $line in
      "$key="*) printf '%s' "${line#*=}"; return 0 ;;
    esac
  done < "$file"
}

file_project=$(instance_value REMO_COMPOSE_PROJECT)
file_alias=$(instance_value REMO_WEB_ALIAS)
PROJECT=${file_project:-${REMO_COMPOSE_PROJECT:-remo}}
ALIAS=${file_alias:-${REMO_WEB_ALIAS:-remo-web}}
# Compose interpolates its files from the environment, so the alias must be exported.
export REMO_WEB_ALIAS=$ALIAS

# First deploy of a new instance records the identity. Later deploys may not move an
# instance to another project: that would orphan its containers, volume and database.
record_instance() {
  local file="$ROOT/shared/instance.env" tmp
  [[ -f $file ]] && return 0
  tmp="$file.tmp.$$"
  printf 'REMO_COMPOSE_PROJECT=%s\nREMO_WEB_ALIAS=%s\n' "$PROJECT" "$ALIAS" > "$tmp"
  mv "$tmp" "$file"
}

# A release may not disagree with the identity the server already has.
same_instance() {
  local wanted_project=$1 wanted_alias=$2
  [[ -z $file_project || $file_project == "$wanted_project" ]] || {
    echo "This directory belongs to compose project $file_project, not $wanted_project." >&2
    return 1
  }
  [[ -z $file_alias || $file_alias == "$wanted_alias" ]] || {
    echo "This directory uses web alias $file_alias, not $wanted_alias." >&2
    return 1
  }
}

use_release() {
  local revision=$1
  [[ $revision =~ ^[0-9a-f]{40}$ ]] || { echo 'Expected a full Git commit.' >&2; exit 1; }
  RELEASE="$ROOT/releases/$revision"
  [[ -f "$RELEASE/deploy/compose.production.yml" ]] || exit 1
  export REMO_RELEASE=$revision
  export REMO_COMMIT=$revision
  if [[ -z ${REMO_VERSION:-} ]]; then
    REMO_VERSION=$(sed -n 's/^  "version": "\(.*\)",$/\1/p' "$RELEASE/package.json" | head -1)
    export REMO_VERSION=${REMO_VERSION:-0.0.0}
  fi
  export REMO_BUILD=${REMO_BUILD:-0}
}
compose() {
  docker compose -p "$PROJECT" --env-file "$REMO_PRODUCTION_ENV" -f "$RELEASE/deploy/compose.production.yml" "$@"
}
current() {
  [[ -f "$ROOT/current" ]] || { echo 'No active release.' >&2; exit 1; }
  use_release "$(cat "$ROOT/current")"
}
# A stand may keep only a few days of dumps. The setting lives in `production.env` as
# data and is opt-in: unset (production) keeps every dump until an operator removes it.
backup_keep_days() {
  local line
  [[ -r $REMO_PRODUCTION_ENV ]] || return 0
  while IFS= read -r line; do
    case $line in
      REMO_BACKUP_KEEP_DAYS=*) printf '%s' "${line#*=}" ;;
    esac
  done < "$REMO_PRODUCTION_ENV"
}

prune_backups() {
  local days
  days=$(backup_keep_days)
  [[ $days =~ ^[0-9]+$ ]] && (( days > 0 )) || return 0
  find "$ROOT/backups" -maxdepth 1 -type f -name '*.dump' -mtime "+$days" -delete
}

backup() {
  local revision=${1:-$REMO_RELEASE}
  local partial file
  partial=$(mktemp "$ROOT/backups/$(date -u +%Y%m%dT%H%M%SZ)-$revision.partial.XXXXXXXX") || return
  file="${partial%.*.*}-${partial##*.}.dump"
  if ! compose run --rm -T --no-deps db-tools pg_dump -Fc < /dev/null > "$partial" ||
     ! compose run --rm -T --no-deps db-tools pg_restore --file=/dev/null < "$partial"; then
    rm -f "$partial"
    return 1
  fi
  mv "$partial" "$file" || return
  prune_backups
  echo "Backup: $file"
}
smoke() {
  compose exec -T web wget -q -O /dev/null http://127.0.0.1:8080/api/health < /dev/null
  compose exec -T web wget -q -O /dev/null http://127.0.0.1:8081/guide/ru/overview/index.html < /dev/null
}

case ${1:-status} in
  deploy)
    use_release "${2:?Usage: remo deploy COMMIT}"
    same_instance "${REMO_COMPOSE_PROJECT:-$PROJECT}" "${REMO_WEB_ALIAS:-$ALIAS}"
    record_instance
    # The shared server belongs to infrastructure; app releases only use a client.
    compose build \
      --build-arg REMO_VERSION="$REMO_VERSION" \
      --build-arg REMO_BUILD="$REMO_BUILD" \
      --build-arg REMO_COMMIT="$REMO_COMMIT" \
      sync web
    compose pull db-tools
    backup_database=$(compose run --rm -T --no-deps db-tools psql -XqAt -v ON_ERROR_STOP=1 -c \
      'select jsonb_build_array(datname, oid, extract(epoch from pg_postmaster_start_time())::text) from pg_database where datname = current_database()' < /dev/null)
    [[ -n $backup_database ]] || { echo 'Could not identify the backup database.' >&2; exit 1; }
    compose run --rm -T --no-deps -e "REMO_BACKUP_DATABASE=$backup_database" \
      sync node release-db.mjs --check-connections < /dev/null
    old=""
    if [[ -f "$ROOT/current" ]]; then
      old=$(cat "$ROOT/current")
      compose stop web sync
      trap 'echo "Update failed. Writers may be stopped; dump and previous release are retained. Use remo status/logs and explicit rollback." >&2' ERR
    fi
    if ! backup "${old:-$REMO_RELEASE}"; then
      if [[ -n $old ]]; then compose start sync web; fi
      echo 'Backup failed. Database preparation did not start.' >&2
      exit 1
    fi
    compose run --rm -T --no-deps -e "REMO_BACKUP_DATABASE=$backup_database" \
      sync node release-db.mjs < /dev/null
    if [[ -n $old ]]; then printf '%s\n' "$old" > "$ROOT/previous"; fi
    compose up -d --no-build --pull never --no-deps --wait --wait-timeout 180 sync
    compose up -d --no-build --pull never --no-deps --wait --wait-timeout 120 web
    smoke
    printf '%s\n' "$REMO_RELEASE" > "$ROOT/current.next"
    mv "$ROOT/current.next" "$ROOT/current"
    # Keep the installed controller in sync with the release that just passed health.
    install -m 700 "$RELEASE/deploy/remo" "$ROOT/remo.next"
    mv "$ROOT/remo.next" "$ROOT/remo"
    trap - ERR
    echo "Active release: $REMO_RELEASE"
    ;;
  rollback)
    [[ ${2:-} == --schema-compatible ]] || {
      echo 'Check schema compatibility first. Usage: remo rollback --schema-compatible' >&2; exit 1;
    }
    current
    backup
    use_release "$(cat "$ROOT/previous")"
    # Reuse existing images; never rebuild an old release or restore data implicitly.
    compose up -d --no-build --pull never --wait --wait-timeout 180 sync web
    smoke
    printf '%s\n' "$REMO_RELEASE" > "$ROOT/current"
    ;;
  backup) current; backup ;;
  status) current; compose ps ;;
  logs) current; compose logs --tail=100 sync web ;;
  # Operator commands from the release image: the host has no `pnpm` and no checkout.
  # `shared/` is mounted read-only so `--secret-file /shared/…` works without putting a
  # key in the image; stdin stays attached because `secret` reads the key from a prompt.
  cli)
    script=${2:-}
    [[ -n $script ]] || { echo 'Usage: remo cli SCRIPT [ARGS...]' >&2; exit 1; }
    # The scripts are `.mjs`; requiring the extension turned a documented command into
    # "Cannot find module /app/scripts/billing-prices". A name from `scripts/` is enough.
    [[ $script =~ ^[A-Za-z0-9._-]+$ ]] || {
      echo "SCRIPT must be a file in scripts/, not a path: $script" >&2
      exit 1
    }
    case $script in
      *.*) ;;
      *) script="$script.mjs" ;;
    esac
    shift 2
    current
    compose run --rm --no-deps -T -w /app -v "$ROOT/shared:/shared:ro" sync node "/app/scripts/$script" "$@"
    ;;
  *) echo 'Usage: remo {deploy COMMIT|rollback --schema-compatible|backup|status|logs|cli SCRIPT [ARGS...]}  (SCRIPT may omit .mjs)' >&2; exit 1 ;;
esac
