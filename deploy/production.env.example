# Store as /srv/remo/shared/production.env, mode 600; never copy your development .env.
# Installation identity (ADR-261). Defaults are the single production layout; a second
# installation on the same machine sets its own root, compose project and edge alias.
# A release file may carry the same three instead, where `deploy/release.sh` reads them.
# REMO_DEPLOY_ROOT=/srv/stage-ru
# REMO_COMPOSE_PROJECT=stage-ru
# REMO_WEB_ALIAS=stage-ru-web
# Provision this role in the shared server first. Hex passwords avoid URL escaping.
REMO_DB_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
REMO_DB_HOST=shared-postgres
REMO_DB_NETWORK=remo_database
# The database and owner role the tools use. Defaults match the single installation; an
# instance with its own PostgreSQL container names them explicitly (ADR-261).
# REMO_DB_NAME=remo
# REMO_DB_OWNER=remo
# The service connects as the DML-only role created by `pnpm db:rls:setup`; schema,
# the legacy repair and the RLS tools use the owner URL (ADR-178). For local development
# without RLS both may point at the owner.
REMO_APP_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_RAND_HEX_32
DATABASE_URL=postgres://remo_app:REPLACE_WITH_THE_APP_PASSWORD@shared-postgres:5432/remo
REMO_MIGRATION_DATABASE_URL=postgres://remo:REPLACE_WITH_THE_SAME_PASSWORD@shared-postgres:5432/remo
REMO_KEK=REPLACE_WITH_OPENSSL_RAND_BASE64_32
REMO_KEK_ID=v1
REMO_METRICS_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
REMO_APP_ORIGIN=https://boards.example.com
REMO_CORS_ORIGIN=https://boards.example.com
REMO_DOCS_ORIGIN=https://docs.boards.example.com
# Moving to a new public address (ADR-254, spec/rebrand.md §6). Leave both unset on a
# fresh installation. REMO_APP_ORIGIN stays the one canonical address in mail and links;
# the aliases are the old origins that must keep answering during the move. A request
# from an alias origin (or an alias Host) is still served, with `Deprecation: true` and a
# `Link: <new>; rel="successor-version"` header. Comma-separated origins, no paths.
# REMO_APP_ORIGIN_ALIASES=https://remo.letii.ru
# Where a page opened on an alias origin is sent: the socket is closed with 4001 and the
# browser reloads the same path and query on this origin. Set it when the old address
# starts redirecting pages.
# REMO_APP_ORIGIN_MOVED=https://app.remuka.com
# The move notice (spec/rebrand.md §6, spec/rebrand-fixes.md §1). Cookies belong to a host,
# so everyone signs in again on the day the address changes; setting both shows a banner on
# the home and in every room during the last seven days, with the new address and its date.
# Set both or neither: a lone or malformed value logs one warning at start and shows nothing.
# REMO_APP_MOVE_TO=https://app.remuka.com
# REMO_APP_MOVE_AT=2026-12-01
# Cookie notice and consent (ADR-255, spec/cookies.md §3). Leave these unset on a self-host:
# `none` shows nothing and is the safe default. `eu` asks for consent before anything
# optional, `ru` shows a short notice. A typo stops the service; the policy address is
# optional, must be an absolute https page and is ignored without a zone. The personal-data
# consent document is the Russian separate document (156-ФЗ): it is linked from the notice
# and the settings only in the `ru` zone and only when this address is set.
# REMO_COMPLIANCE_ZONE=eu
# Pulse exchange (ADR-258, spec/pulse.md §5). The token is the whole access rule of
# GET /operator/pulse/export; both installations carry the same value. Only the EU
# installation sets REMO_PULSE_PEERS and initiates the hourly collection.
# REMO_PULSE_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
# REMO_PULSE_PEERS=https://app.remuka.ru
# REMO_PULSE_BREAKEVEN=43
# REMO_COOKIE_POLICY_URL=https://boards.example.com/legal/cookies
# REMO_PERSONAL_DATA_CONSENT_URL=https://boards.example.com/legal/personal-data
# Legal acceptance journal (ADR-256, spec/legal-acceptance.md §4). Only an HMAC digest of
# the client address is ever stored, never the address. Defaults follow the zone: no digest
# in `eu`, 1095 days in `ru`; `0` days means do not keep it. A typo stops the service.
# REMO_LEGAL_STORE_IP=1
# REMO_LEGAL_IP_RETENTION_DAYS=1095
# Where content/legal/ lives when the service is not started from the repository root.
# REMO_LEGAL_ROOT=/srv/remo
REMO_EDGE_NETWORK=remo_edge
REMO_METRICS=off
# Transactional mail (ADR-246). Keep the driver disabled until a sending domain is
# verified; `console` is refused in production. `resend` needs REMO_MAIL_FROM and
# REMO_RESEND_API_KEY, `smtp` needs REMO_MAIL_FROM and REMO_SMTP_URL.
REMO_MAIL_DRIVER=disabled
# REMO_MAIL_FROM=remo <no-reply@mail.example.com>
# REMO_MAIL_REPLY_TO=support@example.com
# REMO_MAIL_PRODUCT_NAME=remo
# REMO_RESEND_API_KEY=REPLACE_WITH_A_SEND_ONLY_KEY
# REMO_SMTP_URL=smtps://user:password@smtp.example.com:465
# REMO_REQUIRE_VERIFIED_EMAIL_FOR_INVITES=1
# Support (ADR-250, spec/support.md §2.1). `none` hides the Help item; `link` opens one
# page; `chatwoot` frames the operator's widget page in an iframe. Origin and HMAC secret
# are required together for `chatwoot`, and the service refuses to start with only one.
# The context token is optional until the first-line agent exists: without it
# `/api/support/context` answers 401.
REMO_SUPPORT_PROVIDER=none
# REMO_SUPPORT_URL=https://docs.example.com/support
# REMO_SUPPORT_ORIGIN=https://support.example.com
# REMO_SUPPORT_HMAC_SECRET=REPLACE_WITH_THE_IDENTITY_VALIDATION_TOKEN
# REMO_SUPPORT_CONTEXT_TOKEN=REPLACE_WITH_THE_AGENT_CONTEXT_TOKEN
# REMO_SUPPORT_HOURS=Человек ответит в течение рабочего дня|A person will reply within a working day
# Billing (ADR-247). Off means no plan limits and no billing routes, which is the
# self-host default. Currencies listed here are the ones the installation sells.
REMO_BILLING=off
# REMO_BILLING_CURRENCIES=RUB
# YooKassa webhooks are accepted only from its published addresses; the handler also
# re-reads the payment through the API before trusting it (ADR-248).
# REMO_YOOKASSA_WEBHOOK_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25
# Provider keys can be entered through the app; no global AI key is required.
# AI gateway (ADR-251). Optional: with the URL set, model calls leave sync only through
# the gateway and fail closed when it is down. Without it, sync calls providers directly.
# REMO_AI_GATEWAY_URL=https://10.77.0.2:8080
# REMO_AI_GATEWAY_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
# REMO_AI_GATEWAY_TIMEOUT_MS=65000
# REMO_AI_REGION=eu
# The gateway certificate is a PEM: keep it in a quoted multi-line value (Compose
# env_file) or export it from a file in the unit that starts sync.
# REMO_AI_GATEWAY_CA=<gateway certificate PEM, see guide/admin/deploy>
# Images (ADR-249). `disk` keeps uploads under REMO_FILES_DIR; `s3` needs every
# REMO_S3_* value and a private bucket. MinIO also needs the path-style flag.
REMO_FILES_DRIVER=disk
# REMO_FILES_DIR=/var/lib/remo/files
# REMO_FILES_MAX_BYTES=20971520
# REMO_FILES_MAX_PIXELS=50000000
# REMO_FILES_PER_ROOM=500
# REMO_FILES_CONCURRENCY=2
# REMO_FILES_QUEUE=16
# REMO_S3_ENDPOINT=https://storage.yandexcloud.net
# REMO_S3_REGION=ru-central1
# REMO_S3_BUCKET=remo-files
# REMO_S3_ACCESS_KEY_ID=REPLACE_WITH_A_BUCKET_SCOPED_KEY
# REMO_S3_SECRET_ACCESS_KEY=REPLACE_WITH_THE_BUCKET_SECRET
# REMO_S3_FORCE_PATH_STYLE=1

# Operator commands (ADR-262). `REMO_STAGE` marks a test stand; only a stand sets it,
# production leaves it unset. The CLI asks the acting operator for a TOTP code unless this
# is a stand with `REMO_OPERATOR_CLI_MFA=0`, so the line below is refused on production by
# design.
# REMO_STAGE=1
# REMO_OPERATOR_CLI_MFA=0

# Test stand only (ADR-261, spec/stage.md §5–§6). None of these is read on production:
# `REMO_STAGE_SEED_*` belong to `pnpm stage:seed`, `REMO_STAGE_RESET_*` to
# `pnpm stage:reset`. The seed password is a secret; the address domain is the stand's own
# test domain, never a real customer domain.
# REMO_STAGE_SEED_DOMAIN=stage.remuka.ru
# REMO_STAGE_SEED_PASSWORD=REPLACE_WITH_THE_FIXTURE_PASSWORD
# REMO_STAGE_MAILPIT_URL=http://mail:8025
# REMO_STAGE_RESET_LOG=/srv/REPLACE_WITH_INSTANCE/shared/stage-reset.log
# REMO_STAGE_RESET_ACTOR=REPLACE_WITH_THE_OPERATOR_NAME
# REMO_STAGE_COMPOSE_FILE=deploy/compose.production.yml

# Test stand only: the recipients a real mail driver may write to. Comma-separated
# addresses and domains; empty means "Mailpit only". A letter outside the list becomes
# `mail_outbox.status = 'suppressed'` instead of being sent. Production ignores the key.
# REMO_MAIL_ALLOW_RECIPIENTS=tester@example.com,@example.test

# Test stand only: a required legal document may still be a draft. Production with this
# flag and without `REMO_STAGE=1` refuses to start.
# REMO_LEGAL_ALLOW_DRAFTS=1

# Backups. A stand keeps three days of dumps and deletes older ones after a good backup;
# production leaves this unset and keeps every dump until an operator removes it.
# REMO_BACKUP_KEEP_DAYS=3
