# Chatwoot CE on a test stand (spec/support.md §3). Copy to chatwoot.env, mode 600.
# Never commit the filled file: SECRET_KEY_BASE and the SMTP password are secrets.

FRONTEND_URL=https://support.stage.remuka.ru
SECRET_KEY_BASE=REPLACE_WITH_OPENSSL_RAND_HEX_64
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=REPLACE_WITH_THE_DATABASE_PASSWORD
REDIS_URL=redis://redis:6379

# The stand is small: one web process and one worker keep memory predictable.
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
SIDEKIQ_CONCURRENCY=1

# No self-service signup on a stand: an account exists only for the operator.
ENABLE_ACCOUNT_SIGNUP=false
DISABLE_TELEMETRY=true

# Mail for agent notifications and password resets. Use the same sender domain that the
# installation verified with its provider; a stand should point this at its own inbox.
MAILER_SENDER_EMAIL=Ремука <no-reply@remuka.ru>
SMTP_ADDRESS=postbox.cloud.yandex.net
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_THE_KEY_ID
SMTP_PASSWORD=REPLACE_WITH_THE_KEY_SECRET
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_DOMAIN=remuka.ru
